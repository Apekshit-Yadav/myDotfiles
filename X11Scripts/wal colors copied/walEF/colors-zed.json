{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#0f241a90",
                "editor.background": "#0f241a90",
                "editor.foreground": "#c3c8c5",
                "text": "#c3c8c5",
                "text.muted": "#c3c8c570",
                "text.ignored": "#c3c8c540",
                "text.placeholder": "#c3c8c550",
                "ignored": "#c3c8c530",
                "element.hover": "#c3c8c530",
                "ghost_element.hover": "#46594C30",
                "ghost_element.selected": "#46594C30",
                "ghost_element.active": "#46594C60",
                "border": "#0f241a",
                "editor.highlighted_line.background": "#46594C10",
                "editor.active_line.background": "#46594C10",
                "panel.background": "#0f241a90",
                "title_bar.background": "#0f241a90",
                "title_bar.inactive_background": "#0f241a90",
                "status_bar.background": "#0f241a90",
                "drop_target.background": "#0f241a90",
                "elevated_surface.background": "#0f241a",
                "toolbar.background": "#0f241a90",
                "tab_bar.background": "#0f241a90",
                "tab.inactive_background": "#0f241a90",
                "tab.active_background": "#46594C30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#0f241a",
                "scrollbar.thumb.background": "#46594C",
                "editor.gutter.background": "#0f241a90",
                "terminal.background": "#0f241a10",
                "terminal.foreground": "#c3c8c5",
                "terminal.dim_foreground": "#c3c8c5",
                "terminal.bright_foreground": "#c3c8c5",
                "terminal.ansi.black": "#0f241a",
                "terminal.ansi.red": "#46594C",
                "terminal.ansi.green": "#506759",
                "terminal.ansi.yellow": "#6B6654",
                "terminal.ansi.blue": "#597164",
                "terminal.ansi.magenta": "#67796D",
                "terminal.ansi.cyan": "#73837A",
                "terminal.ansi.white": "#c3c8c5",
                "terminal.ansi.bright_black": "#5e746a",
                "terminal.ansi.bright_red": "#46594C",
                "terminal.ansi.bright_green": "#506759",
                "terminal.ansi.bright_yellow": "#6B6654",
                "terminal.ansi.bright_blue": "#597164",
                "terminal.ansi.bright_magenta": "#67796D",
                "terminal.ansi.bright_cyan": "#73837A",
                "terminal.ansi.bright_white": "#c3c8c5",
                "modified": "#46594C",
                "syntax": {
                    "attribute": {
                        "color": "#46594C"
                    },
                    "boolean": {
                      "color": "#506759"
                    },
                    "comment": {
                      "color": "#5e746a"
                    },
                    "comment.doc": {
                      "color": "#5e746a"
                    },
                    "constant": {
                      "color": "#506759"
                    },
                    "function": {
                      "color": "#73837A"
                    },
                    "keyword": {
                      "color": "#597164"
                    },
                    "number": {
                      "color": "#67796D"
                    },
                    "operator": {
                      "color": "#597164"
                    },
                    "string": {
                      "color": "#46594C"
                    },
                    "variable": {
                      "color": "#506759"
                    }
                },
                "players": [
                  {
                    "cursor": "#46594C",
                    "background": "#0f241a",
                    "selection": "#46594C30"
                  }
                ]
            }
        }
    ]
}
