{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#22243690",
                "editor.background": "#22243690",
                "editor.foreground": "#c8d3f5",
                "text": "#c8d3f5",
                "text.muted": "#c8d3f570",
                "text.ignored": "#c8d3f540",
                "text.placeholder": "#c8d3f550",
                "ignored": "#c8d3f530",
                "element.hover": "#c8d3f530",
                "ghost_element.hover": "#ff757f30",
                "ghost_element.selected": "#ff757f30",
                "ghost_element.active": "#ff757f60",
                "border": "#222436",
                "editor.highlighted_line.background": "#ff757f10",
                "editor.active_line.background": "#ff757f10",
                "panel.background": "#22243690",
                "title_bar.background": "#22243690",
                "title_bar.inactive_background": "#22243690",
                "status_bar.background": "#22243690",
                "drop_target.background": "#22243690",
                "elevated_surface.background": "#222436",
                "toolbar.background": "#22243690",
                "tab_bar.background": "#22243690",
                "tab.inactive_background": "#22243690",
                "tab.active_background": "#ff757f30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#222436",
                "scrollbar.thumb.background": "#ff757f",
                "editor.gutter.background": "#22243690",
                "terminal.background": "#22243610",
                "terminal.foreground": "#c8d3f5",
                "terminal.dim_foreground": "#c8d3f5",
                "terminal.bright_foreground": "#c8d3f5",
                "terminal.ansi.black": "#1b1d2b",
                "terminal.ansi.red": "#ff757f",
                "terminal.ansi.green": "#c3e88d",
                "terminal.ansi.yellow": "#ffc777",
                "terminal.ansi.blue": "#82aaff",
                "terminal.ansi.magenta": "#c099ff",
                "terminal.ansi.cyan": "#86e1fc",
                "terminal.ansi.white": "#828bb8",
                "terminal.ansi.bright_black": "#444a73",
                "terminal.ansi.bright_red": "#ff8d94",
                "terminal.ansi.bright_green": "#c7fb6d",
                "terminal.ansi.bright_yellow": "#ffd8ab",
                "terminal.ansi.bright_blue": "#9ab8ff",
                "terminal.ansi.bright_magenta": "#caabff",
                "terminal.ansi.bright_cyan": "#b2ebff",
                "terminal.ansi.bright_white": "#c8d3f5",
                "modified": "#ff757f",
                "syntax": {
                    "attribute": {
                        "color": "#ff757f"
                    },
                    "boolean": {
                      "color": "#c3e88d"
                    },
                    "comment": {
                      "color": "#444a73"
                    },
                    "comment.doc": {
                      "color": "#444a73"
                    },
                    "constant": {
                      "color": "#c7fb6d"
                    },
                    "function": {
                      "color": "#b2ebff"
                    },
                    "keyword": {
                      "color": "#82aaff"
                    },
                    "number": {
                      "color": "#c099ff"
                    },
                    "operator": {
                      "color": "#82aaff"
                    },
                    "string": {
                      "color": "#ff757f"
                    },
                    "variable": {
                      "color": "#c3e88d"
                    }
                },
                "players": [
                  {
                    "cursor": "#ff757f",
                    "background": "#222436",
                    "selection": "#ff757f30"
                  }
                ]
            }
        }
    ]
}
